	classify -. &nbsp;question&nbsp; .-> answer_question;
	classify -.-> booking;
	classify -.-> complaint;
	classify -.-> other;
	answer_question --> __end__;
	booking --> __end__;
	complaint --> __end__;
	other --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

