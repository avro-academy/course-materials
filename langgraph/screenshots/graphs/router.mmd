config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classify(classify)
	answer_question(answer_question)
	booking(booking)
	complaint(complaint)
	other(other)
	__end__([<p>__end__</p>]):::last
